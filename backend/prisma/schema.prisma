generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id                    String          @id @default(uuid())
  nomUtilisateur        String
  prenomUtilisateur     String
  email                 String          @unique
  motDePasseHache       String
  role                  Role            @default(AUDITEUR)
  actif                 Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  scansLance            Scan[]          @relation("ScanLancePar")
  vulnerabilitesAssignees Vulnerabilite[] @relation("AssigneA")

  @@map("utilisateurs")
}

model Actif {
  id          String         @id @default(uuid())
  nom         String
  adresseIP   String
  type        TypeActif
  critique    NiveauCritique
  dernierScan DateTime?
  createdAt   DateTime       @default(now())
  scans       Scan[]         @relation("ScanActif")

  @@map("actifs")
}

model Scan {
  id             String          @id @default(uuid())
  idActif        String
  lanceParId     String
  type           TypeScan
  outil          OutilScan
  statut         StatutScan      @default(EN_COURS)
  debut          DateTime        @default(now())
  fin            DateTime?
  actif          Actif           @relation("ScanActif", fields: [idActif], references: [id])
  lancePar       Utilisateur     @relation("ScanLancePar", fields: [lanceParId], references: [id])
  vulnerabilites Vulnerabilite[] @relation("DetecteeDans")

  @@index([idActif])
  @@index([lanceParId])
  @@map("scans")
}

model Vulnerabilite {
  id          String             @id @default(uuid())
  idScan      String
  cveId       String?
  titre       String
  severite    Severite
  scoreCVSS   Float?
  statut      StatutVulnerabilite @default(OUVERTE)
  assigneAId  String?
  createdAt   DateTime           @default(now())
  scan        Scan               @relation("DetecteeDans", fields: [idScan], references: [id])
  assigneA    Utilisateur?       @relation("AssigneA", fields: [assigneAId], references: [id])

  @@index([idScan])
  @@index([assigneAId])
  @@map("vulnerabilites")
}

enum Role {
  ADMIN
  AUDITEUR
  RESPONSABLE
}

enum TypeActif {
  SERVEUR
  APPLICATION
  RESEAU
  BASE_DE_DONNEES
}

enum NiveauCritique {
  BAS
  MOYEN
  ELEVE
  CRITIQUE
}

enum TypeScan {
  VULNERABILITE
  PENETRATION
  CONFIGURATION
}

enum OutilScan {
  NMAP
  OPENVAS
  NESSUS
  BURP
  ZAP
}

enum Severite {
  BAS
  MOYEN
  ELEVE
  CRITIQUE
}

enum StatutScan {
  EN_COURS
  TERMINE
  ANNULE
}

enum StatutVulnerabilite {
  OUVERTE
  EN_COURS
  CORRIGEE
  FERME
}
